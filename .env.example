EXPO_PUBLIC_API_URL=https://e3kt7e3dag.execute-api.ap-south-1.amazonaws.com
# Set all six Firebase client values together in local .env.
# Release workflows receive these build inputs from GitHub Actions Secrets.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Public OAuth IDs from the supplied com.AdiSai.fintrack registration.
# An iOS registration change must also update googleAuthConfig.ts and app.json.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Optional place autocomplete. Restrict the key in its Google Cloud project.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
