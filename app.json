{
  "expo": {
    "name": "Splittrack",
    "slug": "Splittrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-light.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.AdiSai.fintrack",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      },
      "icon": {
        "light": "./assets/icon-light.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "package": "com.AdiSai.fintrack",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Splittrack to choose a photo for a member profile."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Splittrack to access your location to automatically tag expenses."
        }
      ],
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.828945864022-hg0dlg1ghp116ft9j3dg96a2r1jn9aih"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# Expo reflection and native JNI callbacks must retain their release names.\n-keep class expo.modules.gl.GLView { *; }\n-keep class expo.modules.gl.GLContext { *; }\n-keep class expo.modules.gl.cpp.EXGL { *; }\n-keep class expo.modules.blurview.views.ProgressiveBlurView { *; }\n-keep class com.qmdeve.blurview.BlurNative { *; }"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-transparent.png",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 1,
          "dark": {
            "image": "./assets/splash-transparent.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-router"
    ]
  }
}
